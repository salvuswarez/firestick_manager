{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(adb:*)",
      "Bash(fire-tools:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf assets/*)",
      "Bash(rm -rf archive/*)"
    ]
  }
}
