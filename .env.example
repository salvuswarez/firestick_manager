# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# SMB (router-USB / NAS) share used for Kodi backup storage.
SMB_HOST=192.168.1.1
SMB_SHARE=Kodi
SMB_USER=changeme
SMB_PASS=changeme
SMB_BACKUP_DIR=backups

# ADB timeouts, in seconds. Optional — defaults below match the library.
# Bump ADB_TRANSFER_TIMEOUT_S if capture/deploy times out mid-pull/push on a
# slow network or a device with a large Kodi profile; bump
# ADB_SHELL_TIMEOUT_S if a single shell command (e.g. `tar czf` over a large
# userdata dir) times out before completing.
ADB_SHELL_TIMEOUT_S=60
ADB_TRANSFER_TIMEOUT_S=180
