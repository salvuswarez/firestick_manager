# Copy this file to devices.yml and fill in real devices, or run
# `uv run fire-tools scan` to auto-populate it. devices.yml is gitignored —
# it accumulates real MAC addresses/IPs from your network, never commit it.
#
# `ip`/`mac`/`name` are written by `scan`. `display` is written by `capture`
# (reads the device's live guisettings.xml) and reapplied by `deploy` after
# every sync — hand-add it only to pre-seed calibration before a first
# capture, or run `uv run fire-tools apply-display <ip> --resolution-index
# ... --overscan ...` to set it live and let the next capture record it.

devices:
  - ip: 192.168.1.50
    mac: aa:bb:cc:dd:ee:ff
    name: Example Fire TV
  - ip: 192.168.1.51
    mac: aa:bb:cc:dd:ee:00
    name: Another Example Fire TV
    display:
      resolution_index: 16
      overscan:
        left: 0
        top: 0
        right: 1920
        bottom: 1080
